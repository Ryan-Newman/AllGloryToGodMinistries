<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="All Glory to God Ministries — the good news of salvation through Jesus Christ. Learn the steps to be saved and follow our ministry." />
    <meta name="theme-color" content="#1b1340" />
    <title>All Glory to God Ministries</title>

    <!-- Open Graph / social sharing -->
    <meta property="og:title" content="All Glory to God Ministries" />
    <meta property="og:description" content="The good news of salvation through Jesus Christ." />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        /* =========================================================
           All Glory to God Ministries — styles (inlined)
           Palette: black & gold (professional)
           ========================================================= */

        :root {
            --indigo-900: #050505;
            --indigo-800: #0b0b0b;
            --indigo-700: #131313;
            --purple-600: #1a1712;
            --gold: #d4af37;
            --gold-bright: #f3d77c;
            --gold-deep: #b8922e;
            --cream: #f5f1e6;
            --cream-soft: #c7c0ad;
            --panel: rgba(255, 255, 255, 0.035);
            --panel-line: rgba(212, 175, 55, 0.28);
            --ink: #0a0a0a;
            --shadow: rgba(0, 0, 0, 0.6);
            --serif-display: "Cinzel", Georgia, serif;
            --serif-body: "EB Garamond", "Cormorant Garamond", Georgia, serif;
            --serif-script: "Cormorant Garamond", Georgia, serif;
            --maxw: 1080px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: var(--serif-body);
            font-size: 1.18rem;
            line-height: 1.75;
            color: var(--cream);
            background: radial-gradient(circle at 50% -10%, rgba(212, 175, 55, 0.16), transparent 42%), radial-gradient(circle at 85% 110%, rgba(212, 175, 55, 0.08), transparent 45%), linear-gradient(180deg, #000000 0%, var(--indigo-800) 45%, #000000 120%);
            background-attachment: fixed;
            overflow-x: hidden;
        }

        .container {
            width: min(var(--maxw), 90%);
            margin: 0 auto;
        }

        a {
            color: var(--gold-bright);
            text-decoration: none;
            transition: color 0.2s ease;
        }

            a:hover {
                color: var(--cream);
            }

        /* ---------- Decorative rays ---------- */
        .rays {
            position: fixed;
            inset: -20% 0 auto 0;
            height: 1000vh;
            pointer-events: none;
            z-index: 0;
            background: conic-gradient(from 180deg at 50% 0%, transparent 0deg, rgba(246, 221, 154, 0.06) 12deg, transparent 24deg, rgba(246, 221, 154, 0.05) 36deg, transparent 48deg, rgba(246, 221, 154, 0.06) 60deg, transparent 72deg);
            opacity: 0.9;
        }

        /* ---------- Header / Nav ---------- */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 50;
            backdrop-filter: blur(10px);
            background: rgba(0, 0, 0, 0.82);
            border-bottom: 1px solid var(--panel-line);
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: min(var(--maxw), 92%);
            margin: 0 auto;
            padding: 0.85rem 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--cream);
        }

        .brand-cross {
            color: var(--gold);
            font-size: 1.5rem;
        }

        .brand-mark {
            width: 30px;
            height: 30px;
            flex: none;
        }

        .brand-name {
            font-family: var(--serif-display);
            font-weight: 600;
            letter-spacing: 0.04em;
            font-size: 1.05rem;
        }

        .nav-links {
            display: flex;
            gap: 1.8rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .nav-links a {
                font-family: var(--serif-display);
                font-size: 0.86rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--cream-soft);
            }

                .nav-links a:hover {
                    color: var(--gold-bright);
                }

        .nav-toggle {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: 0;
            cursor: pointer;
            padding: 6px;
        }

            .nav-toggle span {
                width: 26px;
                height: 2px;
                background: var(--gold);
                transition: transform 0.3s ease, opacity 0.3s ease;
            }

        /* ---------- Hero ---------- */
        .hero {
            position: relative;
            z-index: 1;
            min-height: 92vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 1.5rem 3rem;
        }

        .hero-inner {
            max-width: 760px;
        }

        .hero-eyebrow {
            font-family: var(--serif-display);
            letter-spacing: 0.32em;
            text-transform: uppercase;
            font-size: 0.78rem;
            color: var(--gold);
            margin-bottom: 1.2rem;
        }

        .hero-title {
            font-family: var(--serif-display);
            font-weight: 700;
            font-size: clamp(2.6rem, 7vw, 5rem);
            line-height: 1.05;
            margin: 0 0 1.5rem;
            /* Molten-gold shimmer text */
            background: linear-gradient( 100deg, var(--gold-deep) 18%, var(--gold) 32%, #fff6d8 50%, var(--gold-bright) 60%, var(--gold-deep) 82% );
            background-size: 220% auto;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 4px 26px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 30px rgba(212, 175, 55, 0.22));
            animation: goldShimmer 7s linear infinite, titleWipe 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }

        .hero-verse {
            font-family: var(--serif-script);
            font-style: italic;
            font-size: 1.4rem;
            line-height: 1.6;
            color: var(--cream-soft);
            max-width: 620px;
            margin: 0 auto 2.4rem;
        }

        .ref {
            display: block;
            font-style: normal;
            font-size: 0.95rem;
            color: var(--gold);
            margin-top: 0.6rem;
            letter-spacing: 0.05em;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            font-family: var(--serif-display);
            font-size: 0.9rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.9rem 1.8rem;
            border-radius: 999px;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--gold), var(--gold-bright));
            color: var(--indigo-900);
            box-shadow: 0 8px 26px rgba(232, 200, 122, 0.35);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                color: var(--indigo-900);
                box-shadow: 0 12px 34px rgba(232, 200, 122, 0.5);
            }

        .btn-ghost {
            border: 1px solid rgba(232, 200, 122, 0.6);
            color: var(--cream);
        }

            .btn-ghost:hover {
                background: rgba(232, 200, 122, 0.12);
                transform: translateY(-2px);
                color: var(--cream);
            }

        .scroll-cue {
            margin-top: 3rem;
            font-size: 2rem;
            color: var(--gold);
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(8px);
            }
        }

        /* Title animations */
        @keyframes goldShimmer {
            to {
                background-position: 220% center;
            }
        }

        @keyframes titleWipe {
            from {
                clip-path: inset(0 100% 0 0);
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                clip-path: inset(0 0 0 0);
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ---------- Sections ---------- */
        .section {
            position: relative;
            z-index: 1;
            padding: 5.5rem 0;
        }

        .section-head {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.2rem;
            margin-bottom: 0.6rem;
        }

            .section-head h2 {
                font-family: var(--serif-display);
                font-weight: 600;
                font-size: clamp(1.8rem, 4vw, 2.8rem);
                margin: 0;
                text-align: center;
                /* Gold shimmer text */
                background: linear-gradient( 100deg, var(--gold-deep) 20%, var(--gold) 38%, #fff6d8 50%, var(--gold-bright) 62%, var(--gold-deep) 80% );
                background-size: 220% auto;
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                -webkit-text-fill-color: transparent;
                animation: goldShimmer 7s linear infinite;
                /* Entrance state (revealed when .section-head gets .in) */
                clip-path: inset(0 100% 0 0);
                opacity: 0;
                transition: clip-path 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.9s ease;
            }

            .section-head.in h2 {
                clip-path: inset(0 0 0 0);
                opacity: 1;
            }

        .ornament {
            color: var(--gold);
            font-size: 1.1rem;
            opacity: 0;
            transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.9s ease;
        }

        .section-head .ornament:first-child {
            transform: translateX(34px) scale(0.4);
        }

        .section-head .ornament:last-child {
            transform: translateX(-34px) scale(0.4);
        }

        .section-head.in .ornament {
            opacity: 0.85;
            transform: translateX(0) scale(1);
        }

        .section-sub {
            text-align: center;
            color: var(--cream-soft);
            font-style: italic;
            font-size: 1.15rem;
            max-width: 640px;
            margin: 0.4rem auto 3rem;
        }

        /* ---------- Message / Scripture card ---------- */
        .scripture-card {
            max-width: 800px;
            margin: 0 auto;
            background: linear-gradient(180deg, rgba(247, 241, 227, 0.07), rgba(247, 241, 227, 0.03));
            border: 1px solid rgba(232, 200, 122, 0.28);
            border-radius: 18px;
            padding: 3rem clamp(1.5rem, 5vw, 3.5rem);
            box-shadow: 0 20px 60px var(--shadow);
            position: relative;
        }

            .scripture-card::before,
            .scripture-card::after {
                content: "✦";
                position: absolute;
                color: var(--gold);
                opacity: 0.5;
                font-size: 1.1rem;
            }

            .scripture-card::before {
                top: 1rem;
                left: 1.2rem;
            }

            .scripture-card::after {
                bottom: 1rem;
                right: 1.2rem;
            }

            .scripture-card p {
                margin: 0 0 1.4rem;
            }

            .scripture-card .lead {
                font-size: 1.25rem;
            }

            .scripture-card strong {
                color: var(--gold-bright);
                font-weight: 600;
            }

        .dropcap {
            float: left;
            font-family: var(--serif-display);
            font-size: 4.2rem;
            line-height: 0.8;
            padding: 0.3rem 0.6rem 0 0;
            color: var(--gold);
        }

        .closing-line {
            text-align: center;
            font-family: var(--serif-script);
            font-style: italic;
            font-size: 1.35rem;
            color: var(--gold-bright);
            border-top: 1px solid rgba(232, 200, 122, 0.25);
            padding-top: 1.6rem;
            margin-top: 2rem !important;
        }

        /* ---------- Steps ---------- */
        .steps {
            list-style: none;
            margin: 0 auto;
            padding: 0;
            max-width: 920px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.4rem;
        }

        .step {
            position: relative;
            background: var(--panel);
            border: 1px solid var(--panel-line);
            border-radius: 16px;
            padding: 2.4rem 1.6rem 1.8rem;
            text-align: center;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .step:hover {
                transform: translateY(-6px);
                border-color: var(--gold);
                box-shadow: 0 16px 40px var(--shadow);
            }

        .step-num {
            position: absolute;
            top: -22px;
            left: 50%;
            transform: translateX(-50%);
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            font-family: var(--serif-display);
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--indigo-900);
            background: linear-gradient(135deg, var(--gold), var(--gold-bright));
            border-radius: 50%;
            box-shadow: 0 6px 18px rgba(232, 200, 122, 0.4);
        }

        .step h3 {
            font-family: var(--serif-display);
            font-size: 1.3rem;
            margin: 0.4rem 0 0.7rem;
            color: var(--gold-bright);
        }

        .step p {
            font-size: 1.05rem;
            margin: 0 0 1rem;
            color: var(--cream-soft);
        }

        .step-ref {
            font-family: var(--serif-display);
            font-size: 0.78rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--gold);
        }

        /* ---------- Prayer ---------- */
        .prayer {
            max-width: 760px;
            margin: 3.5rem auto 0;
            text-align: center;
            background: linear-gradient(180deg, rgba(232, 200, 122, 0.12), rgba(232, 200, 122, 0.04));
            border: 1px solid rgba(232, 200, 122, 0.35);
            border-radius: 18px;
            padding: 2.6rem clamp(1.5rem, 5vw, 3rem);
        }

            .prayer h3 {
                font-family: var(--serif-display);
                font-size: 1.5rem;
                color: var(--gold-bright);
                margin: 0 0 1.2rem;
            }

        .prayer-text {
            font-family: var(--serif-script);
            font-style: italic;
            font-size: 1.3rem;
            line-height: 1.7;
            color: var(--cream);
        }

        .prayer-note {
            font-size: 1.02rem;
            color: var(--cream-soft);
            margin-top: 1.4rem;
        }

        /* ---------- What We Believe ---------- */
        .belief-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.4rem;
            max-width: 980px;
            margin: 0 auto;
        }

        .belief-card {
            background: var(--panel);
            border: 1px solid var(--panel-line);
            border-left: 3px solid var(--gold);
            border-radius: 14px;
            padding: 1.8rem 1.6rem 1.5rem;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .belief-card:hover {
                transform: translateY(-4px);
                border-color: var(--gold);
                box-shadow: 0 14px 36px var(--shadow);
            }

            .belief-card h3 {
                font-family: var(--serif-display);
                font-size: 1.22rem;
                color: var(--gold-bright);
                margin: 0 0 0.7rem;
                line-height: 1.3;
            }

            .belief-card p {
                font-size: 1.05rem;
                color: var(--cream-soft);
                margin: 0 0 1rem;
            }

        .belief-ref {
            display: block;
            font-family: var(--serif-display);
            font-size: 0.74rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--gold);
            border-top: 1px solid rgba(232, 200, 122, 0.18);
            padding-top: 0.8rem;
        }

        /* ---------- Connect / Social ---------- */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1.2rem;
            max-width: 860px;
            margin: 0 auto;
        }

        .social-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.8rem;
            padding: 1.8rem 1rem;
            border-radius: 16px;
            background: var(--panel);
            border: 1px solid var(--panel-line);
            color: var(--cream);
            font-family: var(--serif-display);
            font-size: 0.95rem;
            letter-spacing: 0.05em;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
        }

            .social-card svg {
                width: 38px;
                height: 38px;
                fill: var(--gold);
                transition: fill 0.25s ease, transform 0.25s ease;
            }

            .social-card:hover {
                transform: translateY(-6px);
                color: var(--cream);
                border-color: var(--gold);
                box-shadow: 0 16px 36px var(--shadow);
            }

                .social-card:hover svg {
                    transform: scale(1.1);
                }

            .social-card.yt:hover {
                background: rgba(255, 0, 0, 0.18);
            }

                .social-card.yt:hover svg {
                    fill: #ff4d4d;
                }

            .social-card.fb:hover {
                background: rgba(24, 119, 242, 0.18);
            }

                .social-card.fb:hover svg {
                    fill: #4d94ff;
                }

            .social-card.tt:hover {
                background: rgba(0, 0, 0, 0.35);
            }

                .social-card.tt:hover svg {
                    fill: #69f0e0;
                }

            .social-card.ig:hover {
                background: rgba(221, 42, 123, 0.18);
            }

                .social-card.ig:hover svg {
                    fill: #ff79c0;
                }

            .social-card.x:hover {
                background: rgba(0, 0, 0, 0.35);
            }

                .social-card.x:hover svg {
                    fill: #ffffff;
                }

        /* ---------- Support / Give ---------- */
        .support {
            max-width: 640px;
            margin: 3.5rem auto 0;
            text-align: center;
            background: linear-gradient(180deg, rgba(212, 175, 55, 0.12), rgba(212, 175, 55, 0.03));
            border: 1px solid var(--panel-line);
            border-radius: 18px;
            padding: 2.4rem clamp(1.5rem, 5vw, 2.8rem);
        }

            .support h3 {
                font-family: var(--serif-display);
                font-size: 1.45rem;
                color: var(--gold-bright);
                margin: 0 0 0.7rem;
            }

            .support > p {
                color: var(--cream-soft);
                margin: 0 0 1.6rem;
            }

        .support-btns {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .give-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            font-family: var(--serif-display);
            font-size: 0.95rem;
            letter-spacing: 0.04em;
            padding: 0.8rem 1.6rem;
            border-radius: 999px;
            border: 1px solid var(--panel-line);
            color: var(--cream);
            background: rgba(0, 0, 0, 0.4);
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

            .give-btn:hover {
                transform: translateY(-2px);
                border-color: var(--gold);
                color: var(--gold-bright);
                box-shadow: 0 10px 26px var(--shadow);
            }

        .give-icon {
            display: grid;
            place-items: center;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            font-weight: 700;
            font-family: var(--serif-display);
            color: var(--ink);
            background: linear-gradient(135deg, var(--gold), var(--gold-bright));
        }

        .give-btn.venmo .give-icon {
            font-style: italic;
        }

        .give-verse {
            font-family: var(--serif-script);
            font-style: italic;
            color: var(--gold);
            margin: 1.6rem 0 0;
        }

        /* ---------- Discipleship ---------- */
        .disciple-group {
            max-width: 1040px;
            margin: 0 auto 3.2rem;
        }

        .group-title {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            justify-content: center;
            font-family: var(--serif-display);
            font-weight: 600;
            font-size: clamp(1.15rem, 2.4vw, 1.5rem);
            color: var(--gold-bright);
            text-align: center;
            margin: 0 0 1.6rem;
            letter-spacing: 0.03em;
        }

            .group-title::before,
            .group-title::after {
                content: "";
                height: 1px;
                flex: 1 1 0;
                max-width: 90px;
                background: linear-gradient(90deg, transparent, var(--panel-line), transparent);
            }

        .disciple-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1.4rem;
        }

        .disciple-card {
            display: flex;
            flex-direction: column;
            flex: 1 1 290px;
            max-width: 340px;
            background: var(--panel);
            border: 1px solid var(--panel-line);
            border-top: 3px solid var(--gold);
            border-radius: 14px;
            padding: 1.8rem 1.6rem 1.5rem;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .disciple-card:hover {
                transform: translateY(-5px);
                border-color: var(--gold);
                box-shadow: 0 16px 40px var(--shadow);
            }

        .disciple-logo {
            position: relative;
            display: grid;
            place-items: center;
            width: 72px;
            height: 72px;
            margin-bottom: 1.1rem;
            border-radius: 16px;
            background: var(--cream);
            border: 1px solid var(--panel-line);
            box-shadow: 0 6px 18px var(--shadow);
            overflow: hidden;
            font-family: var(--serif-display);
            font-weight: 700;
            font-size: 1.7rem;
            letter-spacing: 0.02em;
            color: var(--ink);
        }

            .disciple-logo::before {
                content: attr(data-mono);
                position: absolute;
                z-index: 0;
            }

            .disciple-logo img {
                position: relative;
                z-index: 1;
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 12px;
                background: var(--cream);
            }
            /* Monogram badges (for sites without a usable favicon) */
            .disciple-logo.mono {
                background: linear-gradient(135deg, var(--gold-deep), var(--gold), var(--gold-bright));
                color: var(--ink);
                border-color: transparent;
            }
            /* Wide banner logo (for horizontal/header-style logos) */
            .disciple-logo.wide {
                width: 100%;
                max-width: 215px;
                height: 62px;
            }

                .disciple-logo.wide img {
                    padding: 8px 12px;
                }

        .disciple-card h3 {
